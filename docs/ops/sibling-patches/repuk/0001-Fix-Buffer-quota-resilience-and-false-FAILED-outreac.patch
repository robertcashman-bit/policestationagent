+/**
+ * Schedule with resilience: primary image → site fallback → text-only (non-GBP).
+ * GBP still requires a valid image after fallback.
+ */
+async function createScheduledBufferPostWithMediaFallback(
+  apiKey: string,
+  input: Parameters<typeof createScheduledBufferPost>[1] & { fallbackImageUrl?: string },
+): Promise<Awaited<ReturnType<typeof createScheduledBufferPost>>> {
+  const { fallbackImageUrl, ...base } = input;
+  const isGbp = base.channelService === 'googlebusiness';
+
+  try {
+    return await createScheduledBufferPostWithRetry(apiKey, base);
+  } catch (err) {
+    const message = err instanceof Error ? err.message : String(err);
+    if (!isBufferMediaError(message)) throw err;
+
+    const primary = base.imageUrl?.trim();
+    const fallback = fallbackImageUrl?.trim();
+    if (fallback && fallback !== primary) {
+      try {
+        console.warn(
+          `[buffer-engine] Media error for ${base.feedId}/${base.channelService}; retrying with fallback image`,
+        );
+        return await createScheduledBufferPostWithRetry(apiKey, {
+          ...base,
+          imageUrl: fallback,
+        });
+      } catch (fallbackErr) {
+        const fallbackMsg = fallbackErr instanceof Error ? fallbackErr.message : String(fallbackErr);
+        if (isGbp || !isBufferMediaError(fallbackMsg)) throw fallbackErr;
+      }
+    } else if (isGbp) {
+      throw err;
+    }
+
+    if (isGbp) throw err;
+
+    console.warn(
+      `[buffer-engine] Media error for ${base.feedId}/${base.channelService}; retrying text-only`,
+    );
+    return createScheduledBufferPostWithRetry(apiKey, {
+      ...base,
+      imageUrl: undefined,
+      forceTextOnly: true,
+    });
+  }
