From acb3938ab7d0fb6b6bb9547eeaa7ad9b435e066a Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 10 Aug 2026 12:47:21 +0000
Subject: [PATCH] Add Buffer media fallback URL for PSR Train scheduling
 resilience.

Upgrade vendored buffer-engine so media failures fall back to the hosted default image or text-only posts instead of burning the day quota.
---
 lib/buffer/site-adapter.ts |   1 +
 package-lock.json          | 259 +------------------------------------
 vendor/buffer-engine.tgz   | Bin 55944 -> 59648 bytes
 3 files changed, 3 insertions(+), 257 deletions(-)

diff --git a/lib/buffer/site-adapter.ts b/lib/buffer/site-adapter.ts
index 5622a42..a3fb3bd 100644
--- a/lib/buffer/site-adapter.ts
+++ b/lib/buffer/site-adapter.ts
@@ -36,6 +36,7 @@ export function createPsrtrainBufferAdapter(): BufferEngineAdapter {
     siteId: SITE_ID,
     siteUrl: SITE_URL,
     kv: null,
+    mediaFallbackImageUrl: HOSTED_BUFFER_IMAGE,
     getSchedulablePosts(): SchedulablePost[] {
       const overrides = loadImageOverrides();
       return getLocalPosts().map((p) => ({
